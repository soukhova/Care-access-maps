tm_shape(access_30_parcel_DA_HAM) +
+ tm_fill(col = "quadrant", title = "Spatial autocorrelated clusters",
breaks = c(1, 2, 3, 4, 5, 6),
palette =  c("red", "blue", "lightpink", "skyblue2", "white"),
labels = c("High-High", "Low-Low",
"High-Low","Low-High",
"Non-significant")) +
tm_shape(Community_Boundaries_HAM, is.master = TRUE) + tm_borders("grey20", lwd=1.5) +
tm_shape(Community_Boundaries) + tm_borders("grey20", lwd=2) +
tm_shape(Escpartment_Boundary) + tm_lines(col = "orange", lty = "dashed", lwd=1.5, legend.show=TRUE)+
